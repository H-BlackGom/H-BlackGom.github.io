---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSeriesList, urlOf, formatDate } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const seriesList = await getSeriesList();
  return seriesList.map(({ series, episodes }) => ({
    params: { series: series.id },
    props: { series, episodes },
  }));
}) satisfies GetStaticPaths;

const { series, episodes } = Astro.props;

const total = Math.max(
  series.data.plannedCount ?? episodes.length,
  episodes.length,
);
const percent = total ? Math.round((episodes.length / total) * 100) : 0;
const statusLabel = { ongoing: '연재 중', done: '완결', paused: '중단' }[
  series.data.status
];
---

<BaseLayout
  title={series.data.title}
  description={series.data.description}
  ogImage={series.data.cover}
>
  <header class="series-head page-block">
    <p class="eyebrow">
      <a href="/deepdive">딥다이브</a> · {statusLabel}
    </p>
    <h1>{series.data.title}</h1>
    <p class="series-head__desc muted">{series.data.description}</p>

    <p class="muted series-head__count">
      {episodes.length} / {total}편 · {formatDate(series.data.startedAt)} 시작
    </p>
    <div
      class="series-head__bar"
      role="progressbar"
      aria-valuenow={percent}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="시리즈 진행률"
    >
      <span style={`width:${percent}%`}></span>
    </div>
  </header>

  {
    episodes.length === 0 ? (
      <p class="muted">아직 첫 편을 쓰지 않았습니다.</p>
    ) : (
      <ol class="episodes">
        {episodes.map((episode, i) => (
          <li>
            <a class="card episode" href={urlOf.deepdive(episode)}>
              <span class="episode__num">{i + 1}편</span>
              <span class="episode__body">
                <strong class="episode__title">{episode.data.title}</strong>
                {episode.data.takeaway && (
                  <span class="muted episode__takeaway">
                    {episode.data.takeaway}
                  </span>
                )}
              </span>
              <time
                class="muted episode__date"
                datetime={episode.data.publishedAt.toISOString()}
              >
                {formatDate(episode.data.publishedAt)}
              </time>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>

<style>
  .series-head {
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: var(--bw) solid var(--border);
  }

  .series-head h1 {
    margin-top: 0.5rem;
  }

  .series-head__desc {
    font-family: var(--font-prose);
    -webkit-font-smoothing: antialiased;
    font-size: 1.02rem;
    line-height: 1.8;
    margin-top: 0.9rem;
  }

  .series-head__count {
    font-size: var(--label);
    margin-top: 1.2rem;
  }

  .series-head__bar {
    height: 10px;
    border: var(--bw) solid var(--border);
    background-color: var(--bg-sunken);
    background-image: radial-gradient(var(--dot) 1px, transparent 0);
    background-size: 4px 4px;
    overflow: hidden;
    margin-top: 0.5rem;
    max-width: 22rem;
  }

  .series-head__bar > span {
    display: block;
    height: 100%;
    background: var(--accent);
  }

  .episodes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    counter-reset: none;
    max-width: calc(var(--measure) + 12rem);
  }

  .episode {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
  }

  .episode__num {
    font-size: var(--label);
    font-weight: 700;
    color: var(--accent);
  }

  .episode__body {
    display: grid;
    gap: 0.2rem;
  }

  .episode__title {
    font-size: 1.05rem;
    letter-spacing: 0;
  }

  .episode__takeaway {
    font-family: var(--font-prose);
    -webkit-font-smoothing: antialiased;
    font-size: 0.88rem;
    line-height: 1.7;
    margin-top: 0.15rem;
  }

  .episode__date {
    font-size: var(--label);
    white-space: nowrap;
    color: var(--fg-faint);
  }

  @media (max-width: 34rem) {
    .episode {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }
    .episode__date {
      grid-column: 2;
    }
  }
</style>
