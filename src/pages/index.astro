---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, SECTIONS, ABOUT } from '../consts';
import { getFeed, tagCounts } from '../lib/content';

const feed = await getFeed();
const recent = feed.slice(0, 9);
const tags = tagCounts(feed).slice(0, 24);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero">
    <p class="eyebrow">{SITE.author}의 기록</p>
    <h1 class="dot hero__title">
      {
        SITE.taglineLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h1>
    <p class="hero__lede">{SITE.description}</p>
  </section>

  <section class="home-block" aria-labelledby="sections-heading">
    <h2 id="sections-heading" class="visually-hidden">섹션</h2>
    <div class="grid">
      {
        SECTIONS.map((section) => (
          <a class="card card--quiet section-card" href={section.href}>
            <h3>{section.label}</h3>
            <p class="section-card__blurb">{section.blurb}</p>
          </a>
        ))
      }

      {/* 콘텐츠 섹션이 아니라 사람이라 배경을 한 톤 낮춰 구분합니다.
          섹션 5개 + 이 카드 = 6개라 3열에서 두 줄이 딱 맞습니다. */}
      <a
        class="card card--quiet section-card section-card--about"
        href={ABOUT.href}
      >
        <h3>{ABOUT.label}</h3>
        <p class="section-card__blurb">{SITE.author}</p>
      </a>
    </div>
  </section>

  <section class="home-block" aria-labelledby="recent-heading">
    <div class="block-head">
      <h2 id="recent-heading" class="dot block-title">최신 글</h2>
      <a href="/rss.xml">RSS 구독</a>
    </div>

    {
      recent.length === 0 ? (
        <p class="muted">
          아직 글이 없습니다. <code>src/content/</code> 아래에 첫 글을 넣어보세요.
        </p>
      ) : (
        <div class="grid">
          {recent.map((item) => (
            <PostCard
              href={item.href}
              title={item.title}
              description={item.description}
              publishedAt={item.publishedAt}
              section={item.section}
              context={item.context}
              tags={item.tags}
            />
          ))}
        </div>
      )
    }
  </section>

  {
    tags.length > 0 && (
      <section class="home-block" aria-labelledby="tags-heading">
        <div class="block-head">
          <h2 id="tags-heading" class="dot block-title">태그</h2>
          <span class="muted">{tags.length}개</span>
        </div>
        <ul class="chips">
          {tags.map(([tag, count]) => (
            <li>
              <a class="tag" href={`/tags/${tag}`}>
                #{tag} <span class="tag__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

</BaseLayout>

<style>
  .hero {
    max-width: var(--measure);
    padding-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  /* 두 줄로 쌓는 도트 제목. 줄바꿈을 <br>로 직접 정하므로 balance를 끕니다. */
  .hero__title {
    margin-top: 0.6rem;
    font-size: var(--dot-2);
    line-height: 1.65;
    text-wrap: normal;
  }

  @media (min-width: 40rem) {
    .hero__title {
      font-size: var(--dot-3);
      line-height: 1.55;
    }
  }

  .hero__lede {
    font-family: var(--font-prose);
    -webkit-font-smoothing: antialiased;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--fg-muted);
    margin-top: 1rem;
  }

  .home-block + .home-block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1.35rem;
    border-bottom: var(--bw) solid var(--border);
    font-size: var(--label);
  }

  /* 섹션 구분 제목. 22px 미만으로 내리면 한글 도트가 깨집니다. */
  .block-title {
    font-size: var(--dot-2);
  }

  .section-card h3 {
    font-size: 1.05rem;
    color: var(--accent);
  }

  /* 주인장 카드 — 콘텐츠 섹션들과 나란히 놓이지만 성격이 달라서
     배경을 한 톤 낮춰 "글 목록이 아니다"를 알립니다. */
  .section-card--about {
    background: var(--bg-sunken);
  }

  .section-card__blurb {
    font-family: var(--font-prose);
    -webkit-font-smoothing: antialiased;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--fg-muted);
    margin-top: 0.4rem;
  }

  .tag__count {
    color: var(--fg-faint);
  }

</style>
